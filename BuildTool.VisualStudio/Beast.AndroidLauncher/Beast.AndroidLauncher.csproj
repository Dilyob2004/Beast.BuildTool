<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <ProjectGuid>{B2476235-789D-49D3-8DCE-9E7290A20B5C}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Beast.AndroidLauncher</RootNamespace>
    <AssemblyName>Beast.AndroidLauncher</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <RuntimeIdentifier>win</RuntimeIdentifier>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin\</OutputPath>
    <IntermediateOutputPath>obj\</IntermediateOutputPath>
    <VsInstallRoot>C:\Program Files\Microsoft Visual Studio\18\Community</VsInstallRoot>
    <VsIdePath>$(VsInstallRoot)\Common7\IDE</VsIdePath>
    <VsProjectSystemPath>$(VsIdePath)\CommonExtensions\Microsoft\Project</VsProjectSystemPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" ExcludeAssets="all" GeneratePathProperty="true" />
    <Reference Include="Microsoft.VisualStudio.ProjectSystem">
      <HintPath>$(VsProjectSystemPath)\Microsoft.VisualStudio.ProjectSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.ProjectSystem.VS">
      <HintPath>$(VsProjectSystemPath)\Microsoft.VisualStudio.ProjectSystem.VS.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.15.0">
      <HintPath>$(VsIdePath)\PublicAssemblies\Microsoft.VisualStudio.Shell.15.0.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Design" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(VsIdePath)\PrivateAssemblies\Newtonsoft.Json.13.0.4.0\Newtonsoft.Json.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.Framework"><HintPath>$(VsIdePath)\PublicAssemblies\Microsoft.VisualStudio.Shell.Framework.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.Interop"><HintPath>$(VsIdePath)\PublicAssemblies\Microsoft.VisualStudio.Interop.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.Threading"><HintPath>$(VsIdePath)\PublicAssemblies\Microsoft.VisualStudio.Threading.17.x\Microsoft.VisualStudio.Threading.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="envdte"><HintPath>$(VsIdePath)\PublicAssemblies\envdte.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AndroidEmulatorDebugLaunchProvider.cs" />
    <Compile Include="BeastLaunchPackage.cs" />
    <Compile Include="HotReloadLaunch.cs" />
    <Compile Include="WindowsLaunchPolicy.cs" />
    <Compile Include="WindowsDebugLaunchProvider.cs" />
    <EmbeddedResource Include="$(IntermediateOutputPath)Menus.ctmenu"><LogicalName>Menus.ctmenu</LogicalName></EmbeddedResource>
    <None Include="Commands.vsct" />
    <None Include="ContentTypes.xml" />
    <None Include="source.extension.vsixmanifest" />
  </ItemGroup>

  <Target Name="CompileBeastMenu" BeforeTargets="PrepareResources">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="&quot;$(PkgMicrosoft_VSSDK_BuildTools)\tools\vssdk\bin\VSCT.exe&quot; Commands.vsct &quot;$(IntermediateOutputPath)Menus.ctmenu&quot; -I&quot;$(PkgMicrosoft_VSSDK_BuildTools)\tools\vssdk\inc&quot; -nologo" />
  </Target>
  <Target Name="BuildVsix" AfterTargets="Build">
    <PropertyGroup>
      <VsixStage>$(IntermediateOutputPath)vsix</VsixStage>
      <VsixPath>$(OutputPath)Beast.AndroidLauncher.vsix</VsixPath>
    </PropertyGroup>
    <RemoveDir Directories="$(VsixStage)" />
    <MakeDir Directories="$(VsixStage)" />
    <Copy SourceFiles="ContentTypes.xml" DestinationFiles="$(VsixStage)\[Content_Types].xml" />
    <Copy SourceFiles="source.extension.vsixmanifest" DestinationFiles="$(VsixStage)\extension.vsixmanifest" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(VsixStage)\Beast.AndroidLauncher.dll" />
    <Exec Command="&quot;$(PkgMicrosoft_VSSDK_BuildTools)\tools\vssdk\bin\CreatePkgDef.exe&quot; /codebase /out=&quot;$(VsixStage)\Beast.AndroidLauncher.pkgdef&quot; /i=&quot;$(VsProjectSystemPath)\Microsoft.VisualStudio.ProjectSystem.dll;$(VsProjectSystemPath)\Microsoft.VisualStudio.ProjectSystem.VS.dll;$(VsIdePath)\PublicAssemblies\Microsoft.VisualStudio.Interop.dll&quot; &quot;$(TargetPath)&quot;" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Compress-Archive -Path '$(VsixStage)\*' -DestinationPath '$(VsixPath)' -Force&quot;" />
  </Target>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
